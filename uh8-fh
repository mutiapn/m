<script>
    // --- DATABASE SOAL ---
    const questionsBank = [
        // FUNGSI LINEAR
        {
            id: 1, topic: 'Fungsi Linear', type: 'mcq',
            q: 'Sistem parkir otomatis bekerja dengan cara: Kamera memindai plat nomor, sistem menghitung durasi parkir dari database, lalu palang pintu terbuka dan layar menampilkan total tagihan biaya. Berdasarkan ilustrasi tersebut, komponen manakah yang bertindak sebagai <b>proses</b>?',
