    // Fungsi Pengacak Array (Fisher-Yates Shuffle)
    function shuffleArray(array) {
        let shuffled = [...array];
        for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        return shuffled;
    }

    // --- LOGIC APP ---
    function startExam() {
        const nameInput = document.getElementById('studentName').value.trim();
        const absenInput = document.getElementById('studentAbsen').value;
        const classSelect = document.getElementById('studentClass').value;
        
        if (!nameInput) {
            alert('Silakan masukkan nama Anda terlebih dahulu!');
            return;
        }

        if (!absenInput) {
            alert('Silakan pilih nomor absen Anda!');
            return;
        }
        
        if (!classSelect) {
            alert('Silakan pilih kelas Anda!');
            return;
        }

        studentData.name = nameInput;
        studentData.absen = absenInput;
        studentData.class = classSelect;

        // Acak urutan soal untuk setiap siswa
        questions = shuffleArray(questionsBank);
        answers = new Array(questions.length).fill(null);
        
        // Simpan progress saat mulai
        saveProgress();

        document.getElementById('loginSection').style.display = 'none';
        document.getElementById('quizSection').style.display = 'block';
        
        // Tampilkan Nama dan Nomor Absen di Header
        document.getElementById('displayName').innerText = `${studentData.name} (Absen: ${studentData.absen})`;
        document.getElementById('displayClass').innerText = studentData.class;

        buildNavGrid();
        renderQuestion();
        
        // Start Timer
        timerInterval = setInterval(() => {
            timeRemaining--;
            saveProgress(); // Simpan setiap detik
            let m = Math.floor(timeRemaining / 60).toString().padStart(2, '0');
            let s = (timeRemaining % 60).toString().padStart(2, '0');
            document.getElementById('timerDisplay').innerText = `${m}:${s}`;
            
            if (timeRemaining <= 0) {
                clearInterval(timerInterval);
                submitExam();
            }
        }, 1000);
    }

    function buildNavGrid() {
        const grid = document.getElementById('navigationGrid');
        grid.innerHTML = '';
        questions.forEach((_, idx) => {
            const btn = document.createElement('div');
            btn.className = 'nav-btn';
            btn.innerText = idx + 1;
            btn.onclick = () => {
                saveShortAnswer();
                currentIdx = idx;
                renderQuestion();
            };
            grid.appendChild(btn);
        });
        updateNavUI();
    }

    function renderQuestion() {
        const qData = questions[currentIdx];
        document.getElementById('questionTitle').innerText = `Soal ${currentIdx + 1}`;
        document.getElementById('topicBadge').innerText = qData.topic;
        document.getElementById('questionText').innerHTML = qData.q;

        const optionsContainer = document.getElementById('optionsContainer');
        const shortAnswerContainer = document.getElementById('shortAnswerContainer');
        const shortInput = document.getElementById('shortAnswerInput');

        if (qData.type === 'mcq') {
            optionsContainer.style.display = 'block';
            shortAnswerContainer.style.display = 'none';
            optionsContainer.innerHTML = '';
            
            qData.options.forEach((opt, optIdx) => {
                const li = document.createElement('li');
                li.className = `option-item ${answers[currentIdx] === optIdx ? 'selected' : ''}`;
                li.innerHTML = opt;
                li.onclick = () => selectOption(optIdx);
                optionsContainer.appendChild(li);
            });
        } else {
            optionsContainer.style.display = 'none';
            shortAnswerContainer.style.display = 'block';
            shortInput.value = answers[currentIdx] !== null ? answers[currentIdx] : '';
            shortInput.onkeyup = () => {
                answers[currentIdx] = shortInput.value.trim();
                saveProgress(); // Simpan saat mengetik
                updateNavUI();
            };
        }
        
        updateNavUI();
    }

    function selectOption(optIdx) {
        answers[currentIdx] = optIdx;
        saveProgress(); // Simpan setelah memilih opsi
        renderQuestion();
    }

    function saveShortAnswer() {
        if (questions[currentIdx].type === 'short') {
            const val = document.getElementById('shortAnswerInput').value.trim();
            if (val !== '') {
                answers[currentIdx] = val;
                saveProgress(); // Simpan jawaban essay
            }
        }
    }

    function nextQuestion() {
        saveShortAnswer();
        if (currentIdx < questions.length - 1) {
            currentIdx++;
            saveProgress();
            renderQuestion();
        }
    }

    function prevQuestion() {
        saveShortAnswer();
        if (currentIdx > 0) {
            currentIdx--;
            saveProgress();
            renderQuestion();
        }
    }

    function updateNavUI() {
        const btns = document.querySelectorAll('.nav-btn');
        btns.forEach((btn, idx) => {
            btn.classList.remove('active', 'answered');
            if (answers[idx] !== null && answers[idx] !== "") {
                btn.classList.add('answered');
            }
            if (idx === currentIdx) {
                btn.classList.add('active');
            }
        });
    }

    function confirmSubmit() {
        saveShortAnswer();
        const unans = answers.filter(a => a === null || a === "").length;
        let msg = "Apakah Anda yakin ingin menyelesaikan ujian?";
        if (unans > 0) {
            msg = `Masih ada ${unans} soal yang belum dijawab. Yakin ingin mengumpulkan?`;
        }
        if (confirm(msg)) {
            clearInterval(timerInterval);
            submitExam();
        }
    }

    function submitExam() {
        let correctCount = 0;
        
        questions.forEach((q, idx) => {
            if (q.type === 'mcq') {
                if (answers[idx] === q.ans) correctCount++;
            } else {
                if (answers[idx]) {
                    // Logika validasi Isian Singkat: hapus semua spasi dan ubah ke huruf kecil
                    let userAnsStr = String(answers[idx]).toLowerCase().replace(/\s+/g, '');
                    let isMatch = q.ans.some(valid => String(valid).toLowerCase().replace(/\s+/g, '') === userAnsStr);
                    if (isMatch) correctCount++;
                }
            }
        });

        const score = Math.round((correctCount / questions.length) * 100);

        document.getElementById('quizSection').style.display = 'none';
        document.getElementById('resultSection').style.display = 'block';
        
        // Tampilkan Identitas Siswa Lengkap di Halaman Hasil
        document.getElementById('resName').innerText = `${studentData.name} (Absen: ${studentData.absen})`;
        document.getElementById('resClass').innerText = studentData.class;
        document.getElementById('finalScore').innerText = score;

        generateReviewUI();
        
        // Tandai ujian telah selesai di memori browser
        saveProgress();
    }

    function generateReviewUI() {
        const container = document.getElementById('reviewContainer');
        container.innerHTML = '<h3 style="margin-bottom:1.5rem; text-align:center;">Detail Pembahasan Soal</h3>';
        
        questions.forEach((q, idx) => {
            let isCorrect = false;
            let userAnswerText = '- Kosong -';
            let correctAnswerText = '';

            if (q.type === 'mcq') {
                isCorrect = (answers[idx] === q.ans);
                if (answers[idx] !== null) userAnswerText = q.options[answers[idx]];
                correctAnswerText = q.options[q.ans];
            } else {
                if (answers[idx]) {
                    let userAnsStr = String(answers[idx]).toLowerCase().replace(/\s+/g, '');
                    isCorrect = q.ans.some(valid => String(valid).toLowerCase().replace(/\s+/g, '') === userAnsStr);
                    userAnswerText = answers[idx];
                }
                correctAnswerText = q.ans[0]; // Tampilkan opsi format jawaban pertama sebagai kunci
            }

            const box = document.createElement('div');
            box.className = 'review-box';
            box.innerHTML = `
                <p><strong>Soal ${idx + 1} (${q.topic}):</strong> ${q.q}</p>
                <p>Jawaban Kamu: <span class="${isCorrect ? 'correct-ans' : 'wrong-ans'}">${userAnswerText} ${isCorrect ? '&#10004;' : '&#10008;'}</span></p>
                <div class="explanation">
                    <p><strong>Kunci Jawaban:</strong> ${correctAnswerText}</p>
                    <p style="margin-top: 0.5rem;"><strong>Pembahasan:</strong> ${q.explanation}</p>
                </div>
            `;
            container.appendChild(box);
        });
    }

    function toggleReview() {
        const container = document.getElementById('reviewContainer');
        if (container.style.display === 'none' || container.style.display === '') {
            container.style.display = 'block';
        } else {
            container.style.display = 'none';
        }
    }

    function promptLogout() {
        const pwd = prompt("Masukkan sandi untuk keluar aplikasi:");
        if (pwd === "7890") {
            // Sandi benar, hapus data ujian dari penyimpanan lokal browser
            localStorage.removeItem('cbtExamState');
            alert("Sesi ujian berhasil dihapus. Kembali ke halaman login.");
            location.reload();
        } else if (pwd !== null) {
            alert("Sandi salah! Anda tidak diizinkan untuk keluar dari halaman ini.");
        }
    }

    function exportCSV() {
        let csvContent = "data:text/csv;charset=utf-8,";
        csvContent += "Nama,No Absen,Kelas,Nilai Akhir\r\n";
        csvContent += `"${studentData.name}","${studentData.absen}","${studentData.class}",${document.getElementById('finalScore').innerText}\r\n\r\n`;
        
        csvContent += "No,ID Soal Asli,Topik,Tipe,Jawaban Siswa\r\n";
        questions.forEach((q, idx) => {
            let ansStr = answers[idx] !== null ? answers[idx] : "";
            if (q.type === 'mcq' && answers[idx] !== null) {
                ansStr = String.fromCharCode(65 + answers[idx]); // Mengubah index 0,1,2,3 jadi A,B,C,D
            }
            csvContent += `${idx + 1},${q.id},${q.topic},${q.type},"${ansStr}"\r\n`;
        });

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `Hasil_Ujian_${studentData.name.replace(/ /g,"_")}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    // EVENT SAAT HALAMAN DIMUAT (CEK LOCAL STORAGE)
    window.onload = function() {
        const savedState = localStorage.getItem('cbtExamState');
        if (savedState) {
            const state = JSON.parse(savedState);
            
            // Kembalikan data ke variabel
            studentData = state.studentData;
            questions = state.questions;
            answers = state.answers;
            timeRemaining = state.timeRemaining;
            currentIdx = state.currentIdx;

            // Kembalikan tampilan UI
            document.getElementById('loginSection').style.display = 'none';
            
            if (state.isFinished) {
                // Jika statusnya sudah selesai ujian, langsung ke halaman hasil
                document.getElementById('quizSection').style.display = 'none';
                document.getElementById('resultSection').style.display = 'block';
                
                document.getElementById('resName').innerText = `${studentData.name} (Absen: ${studentData.absen})`;
                document.getElementById('resClass').innerText = studentData.class;
                
                // Hitung ulang nilai
                let correctCount = 0;
                questions.forEach((q, idx) => {
                    if (q.type === 'mcq') {
                        if (answers[idx] === q.ans) correctCount++;
                    } else {
                        if (answers[idx]) {
                            let userAnsStr = String(answers[idx]).toLowerCase().replace(/\s+/g, '');
                            let isMatch = q.ans.some(valid => String(valid).toLowerCase().replace(/\s+/g, '') === userAnsStr);
                            if (isMatch) correctCount++;
                        }
                    }
                });
                document.getElementById('finalScore').innerText = Math.round((correctCount / questions.length) * 100);
                generateReviewUI();
                
            } else {
                // Jika belum selesai, lanjutkan ujian
                document.getElementById('quizSection').style.display = 'block';
                document.getElementById('displayName').innerText = `${studentData.name} (Absen: ${studentData.absen})`;
                document.getElementById('displayClass').innerText = studentData.class;
                
                buildNavGrid();
                renderQuestion();
                
                // Lanjutkan timer
                timerInterval = setInterval(() => {
                    timeRemaining--;
                    saveProgress(); // Simpan setiap detik
                    let m = Math.floor(timeRemaining / 60).toString().padStart(2, '0');
                    let s = (timeRemaining % 60).toString().padStart(2, '0');
                    document.getElementById('timerDisplay').innerText = `${m}:${s}`;
                    
                    if (timeRemaining <= 0) {
                        clearInterval(timerInterval);
                        submitExam();
                    }
                }, 1000);
            }
        }
    };
</script>

